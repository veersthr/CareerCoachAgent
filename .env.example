# LLM provider: groq | gemini | ollama
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3

CANONICALIZATION_THRESHOLD=0.75

TESSERACT_CMD=

MAX_RETRIES=2
READINESS_SCORE_CAP=65
READINESS_ROLE_WEIGHT_MULTIPLIER=12

SQLITE_PATH=

API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed frontend origins, e.g. https://my-app.vercel.app
# Leave blank/unset for "*" (fine for local dev).
ALLOWED_ORIGINS=

DEBUG=false
